# ── Build-time arguments ─────────────────────────────────────────
ARG RUST_VERSION=1.87
ARG DEBIAN_VERSION=bookworm
ARG GO_VERSION=1.22.4
ARG XCADDY_VERSION=0.4.4
ARG CADDY_VERSION=2.11.4
ARG CADDY_DNS_MODULE=github.com/caddy-dns/cloudflare
ARG APP_PORT=43173
ARG DOMAIN=math.network-communications.net

# ── Stage 1: Build Rust binaries + custom Caddy ──────────────────
FROM docker.io/rust:${RUST_VERSION}-slim-${DEBIAN_VERSION} AS builder

ARG GO_VERSION
ARG XCADDY_VERSION
ARG CADDY_VERSION
ARG CADDY_DNS_MODULE

ENV DEBIAN_FRONTEND=noninteractive

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    m4 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Go
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/app/gopath"
ENV GOCACHE="/app/gocache"

# Build Rust application
WORKDIR /app
COPY rust/ ./rust/
RUN cargo build --release --manifest-path rust/e8_mask_codec/Cargo.toml

# Build Caddy with Cloudflare DNS module via xcaddy
RUN curl -fsSL \
    "https://github.com/caddyserver/xcaddy/releases/download/v${XCADDY_VERSION}/xcaddy_${XCADDY_VERSION}_linux_amd64.tar.gz" \
    | tar -xz -C /usr/local/bin/ xcaddy
RUN xcaddy build "v${CADDY_VERSION}" --with "${CADDY_DNS_MODULE}"


# ── Stage 2: Minimal runtime image ───────────────────────────────
FROM docker.io/debian:${DEBIAN_VERSION}-slim

ARG APP_PORT
ARG DOMAIN

ENV DEBIAN_FRONTEND=noninteractive

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    pari-gp \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/caddy /usr/local/bin/caddy

COPY --from=builder /app/rust/e8_mask_codec/target/release/prime_ui      ./bin/
COPY --from=builder /app/rust/e8_mask_codec/target/release/count_first_n  ./bin/
COPY --from=builder /app/rust/e8_mask_codec/target/release/is_prime       ./bin/
COPY --from=builder /app/rust/e8_mask_codec/target/release/next_prime     ./bin/

RUN printf '%s {\n    tls {\n        dns cloudflare {env.CF_API_TOKEN}\n    }\n    reverse_proxy 127.0.0.1:%s\n}\n' \
    "${DOMAIN}" "${APP_PORT}" > /app/Caddyfile

RUN printf '#!/bin/sh\n/app/bin/prime_ui --host 127.0.0.1 --port %s --archive-dir "${ARCHIVE_DIR:-/app/data/runs/count_1e11/archive}" &\nexec caddy run --config /app/Caddyfile --adapter caddyfile\n' \
    "${APP_PORT}" > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 80 443
VOLUME ["/app/data", "/root/.local/share/caddy"]
CMD ["/app/entrypoint.sh"]